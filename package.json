{
  "name": "notevault-sem5",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "NoteVault — a Semester 5 study library and in-browser PDF reader, built with React, TypeScript and Vite.",
  "homepage": "https://vardhan23v.github.io/sem5/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vardhan23v/sem5.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/index-added.mjs",
    "pretest": "node scripts/index-added.mjs",
    "prebuild": "node scripts/index-added.mjs",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/copy-resources.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "index:added": "node scripts/index-added.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
